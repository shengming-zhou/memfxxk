MEMFXXK_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/memfxxk
MEMFXXK_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/memfxxk_test
MEMFXXK_EMBEDDING__PROVIDER=fake
MEMFXXK_EMBEDDING__BASE_URL=http://localhost:8000/v1
MEMFXXK_EMBEDDING__MODEL=bge-m3
MEMFXXK_EMBEDDING__DIM=1024
MEMFXXK_EMBEDDING__BATCH_SIZE=64
MEMFXXK_EMBEDDING__TIMEOUT=30
MEMFXXK_EMBEDDING__MAX_RETRIES=3
MEMFXXK_EMBEDDING__MAX_INPUT_TOKENS=8000
# MEMFXXK_EMBEDDING__API_KEY=
MEMFXXK_TOKEN_COUNTER=tiktoken
MEMFXXK_SEARCH__N_LEXICAL=50
MEMFXXK_SEARCH__N_VECTOR=50
MEMFXXK_SEARCH__M_IMPORTANT=10
MEMFXXK_SEARCH__HNSW_EF_SEARCH=100
MEMFXXK_SEARCH__RRF_K=60
MEMFXXK_SEARCH__LEXICAL_WEIGHT=1.0
MEMFXXK_SEARCH__VECTOR_WEIGHT=1.0
MEMFXXK_SEARCH__IMPORTANT_BOOST=1.5
MEMFXXK_SEARCH__IMPORTANT_MIN_SIM=0.35
MEMFXXK_SEARCH__MAX_RELATED=3
MEMFXXK_CONTEXT__BUDGET__DOCUMENTS=1500
MEMFXXK_CONTEXT__BUDGET__PINNED=500
MEMFXXK_CONTEXT__BUDGET__WORKING=3000
MEMFXXK_CONTEXT__BUDGET__EVIDENCE=1500
MEMFXXK_WORKER__EMBEDDED=true
MEMFXXK_BUNDLE_RETENTION_DAYS=30
MEMFXXK_ALLOW_HOST_HARD_DELETE=true
